# Server-side only. Copy to .env.local for local Vercel development; never commit real values.
GEMINI_API_KEY=replace_with_a_new_gemini_key
GEMINI_MODEL=gemini-2.5-flash
QDRANT_API_KEY=replace_with_a_new_qdrant_key
QDRANT_URL=https://your-cluster.region.cloud.qdrant.io:6333

# Vercel only: service-account JSON for the SAME Firebase project as .firebaserc.
# Store this as a server-side Vercel environment variable; never put it in public/.
FIREBASE_SERVICE_ACCOUNT={"project_id":"vignesh-resume-dbaaf","client_email":"...","private_key":"..."}
