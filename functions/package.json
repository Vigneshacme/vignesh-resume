    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "vignesh-kumar-cloud-resume": "file:.."
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.24",
    "firebase-functions-test": "^3.1.0",
