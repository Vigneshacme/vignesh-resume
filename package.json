{
  "name": "vignesh-kumar-cloud-resume",
  "version": "1.0.0",
  "description": "Cloud Resume Portfolio with Serverless Hit Tracking and Qdrant RAG Assistant",
  "scripts": {
    "dev": "npx serve public -l 5000",
    "build": "cd functions && npm install && npm run build",
    "seed:qdrant": "cd functions && npm run seed:qdrant",
    "test:e2e": "playwright test",
    "deploy:vercel": "npx vercel --prod",
    "deploy:firebase": "npx -y firebase-tools@latest deploy --only firestore,hosting"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.12.0",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@vercel/node": "^5.0.0",
    "vercel": "^39.0.0"
  }
}
